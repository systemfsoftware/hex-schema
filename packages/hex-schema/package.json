{
  "name": "@systemfsoftware/hex-schema",
  "license": "Apache-2.0",
  "version": "2.0.3",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/hex-schema.git",
    "directory": "packages/hex-schema"
  },
  "homepage": "https://github.com/systemfsoftware/hex-schema/tree/main/packages/hex-schema#readme",
  "bugs": "https://github.com/systemfsoftware/hex-schema/issues",
  "description": "Effect Schema definitions for hexadecimal wire formats — strict, colon-delimited, prefixed, and byte-level schemas with branded types.",
  "keywords": [
    "effect",
    "effect-ts",
    "schema",
    "codec",
    "hex",
    "hexstring",
    "branded-types",
    "validation",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/hex-schema.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/effect-schema-law": "^6.1.0",
    "@systemfsoftware/effect-schema-vite": "^3.1.1",
    "@systemfsoftware/oxlint-config-recommended": "^5.0.0",
    "@systemfsoftware/tsconfig": "^2.0.2",
    "@systemfsoftware/tsdown-config": "^0.1.1",
    "@systemfsoftware/vitest": "^3.0.0",
    "@systemfsoftware/vitest-config": "^0.1.1",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/hex-schema.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
